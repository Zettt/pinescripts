//@version=6
indicator('Multi-Market MA Cross Monitor', shorttitle = 'MA Cross Monitor', overlay = true)

// Input parameters for MA lengths
ema1_len = input.int(20, 'EMA 1 Length', minval = 1)
ema2_len = input.int(50, 'EMA 2 Length', minval = 1)
ema3_len = input.int(200, 'EMA 3 Length', minval = 1)

// Fixed timeframe input for the monitor (default 12H)
monitor_tf = input.timeframe('720', 'Monitor Timeframe')
// Function to get security data and calculate EMAs
get_security_data(sym, tf, ema1_len, ema2_len, ema3_len) =>
    [close_price, ema1, ema2, ema3] = request.security(sym, tf, [close, ta.ema(close, ema1_len), ta.ema(close, ema2_len), ta.ema(close, ema3_len)])
    [close_price, ema1, ema2, ema3]

// Input symbols for 10 markets
sym1 = input.symbol('BINANCE:BTCUSDT', 'Market 1')
sym2 = input.symbol('BINANCE:ETHUSDT', 'Market 2')
sym3 = input.symbol('BINANCE:ADAUSDT', 'Market 3')
sym4 = input.symbol('BINANCE:SOLUSDT', 'Market 4')
sym5 = input.symbol('BINANCE:DOTUSDT', 'Market 5')
sym6 = input.symbol('BINANCE:AVAXUSDT', 'Market 6')
sym7 = input.symbol('BINANCE:LINKUSDT', 'Market 7')
sym8 = input.symbol('BINANCE:MATICUSDT', 'Market 8')
sym9 = input.symbol('BINANCE:UNIUSDT', 'Market 9')
sym10 = input.symbol('BINANCE:AAVEUSDT', 'Market 10')

// Get security data for each market
[close1, ema1_1, ema2_1, ema3_1] = get_security_data(sym1, monitor_tf, ema1_len, ema2_len, ema3_len)
status1_1 = na(close1) or na(ema1_1) or na(ema2_1) ? 'N/A' : ''
status1_2 = na(close1) or na(ema2_1) or na(ema3_1) ? 'N/A' : ''

[close2, ema1_2, ema2_2, ema3_2] = get_security_data(sym2, monitor_tf, ema1_len, ema2_len, ema3_len)
status2_1 = na(close2) or na(ema1_2) or na(ema2_2) ? 'N/A' : ''
status2_2 = na(close2) or na(ema2_2) or na(ema3_2) ? 'N/A' : ''
[close3, ema1_3, ema2_3, ema3_3] = get_security_data(sym3, monitor_tf, ema1_len, ema2_len, ema3_len)
status3_1 = na(close3) or na(ema1_3) or na(ema2_3) ? 'N/A' : ''
status3_2 = na(close3) or na(ema2_3) or na(ema3_3) ? 'N/A' : ''
[close4, ema1_4, ema2_4, ema3_4] = get_security_data(sym4, monitor_tf, ema1_len, ema2_len, ema3_len)
status4_1 = na(close4) or na(ema1_4) or na(ema2_4) ? 'N/A' : ''
status4_2 = na(close4) or na(ema2_4) or na(ema3_4) ? 'N/A' : ''
[close5, ema1_5, ema2_5, ema3_5] = get_security_data(sym5, monitor_tf, ema1_len, ema2_len, ema3_len)
status5_1 = na(close5) or na(ema1_5) or na(ema2_5) ? 'N/A' : ''
status5_2 = na(close5) or na(ema2_5) or na(ema3_5) ? 'N/A' : ''
[close6, ema1_6, ema2_6, ema3_6] = get_security_data(sym6, monitor_tf, ema1_len, ema2_len, ema3_len)
status6_1 = na(close6) or na(ema1_6) or na(ema2_6) ? 'N/A' : ''
status6_2 = na(close6) or na(ema2_6) or na(ema3_6) ? 'N/A' : ''
[close7, ema1_7, ema2_7, ema3_7] = get_security_data(sym7, monitor_tf, ema1_len, ema2_len, ema3_len)
status7_1 = na(close7) or na(ema1_7) or na(ema2_7) ? 'N/A' : ''
status7_2 = na(close7) or na(ema2_7) or na(ema3_7) ? 'N/A' : ''
[close8, ema1_8, ema2_8, ema3_8] = get_security_data(sym8, monitor_tf, ema1_len, ema2_len, ema3_len)
status8_1 = na(close8) or na(ema1_8) or na(ema2_8) ? 'N/A' : ''
status8_2 = na(close8) or na(ema2_8) or na(ema3_8) ? 'N/A' : ''
[close9, ema1_9, ema2_9, ema3_9] = get_security_data(sym9, monitor_tf, ema1_len, ema2_len, ema3_len)
status9_1 = na(close9) or na(ema1_9) or na(ema2_9) ? 'N/A' : ''
status9_2 = na(close9) or na(ema2_9) or na(ema3_9) ? 'N/A' : ''
[close10, ema1_10, ema2_10, ema3_10] = get_security_data(sym10, monitor_tf, ema1_len, ema2_len, ema3_len)
status10_1 = na(close10) or na(ema1_10) or na(ema2_10) ? 'N/A' : ''
status10_2 = na(close10) or na(ema2_10) or na(ema3_10) ? 'N/A' : ''

// Array of symbols for market names
symbols = array.from(sym1, sym2, sym3, sym4, sym5, sym6, sym7, sym8, sym9, sym10)

// Arrays of status variables for easy access
status1_array = array.from(status1_1, status2_1, status3_1, status4_1, status5_1, status6_1, status7_1, status8_1, status9_1, status10_1)
status2_array = array.from(status1_2, status2_2, status3_2, status4_2, status5_2, status6_2, status7_2, status8_2, status9_2, status10_2)

// Arrays for close prices and EMAs
close_prices = array.from(close1, close2, close3, close4, close5, close6, close7, close8, close9, close10)
ema1_array = array.from(ema1_1, ema1_2, ema1_3, ema1_4, ema1_5, ema1_6, ema1_7, ema1_8, ema1_9, ema1_10)
ema2_array = array.from(ema2_1, ema2_2, ema2_3, ema2_4, ema2_5, ema2_6, ema2_7, ema2_8, ema2_9, ema2_10)
ema3_array = array.from(ema3_1, ema3_2, ema3_3, ema3_4, ema3_5, ema3_6, ema3_7, ema3_8, ema3_9, ema3_10)

// Create table
var table info_table = table.new(position.bottom_left, 3, 11, bgcolor = color.white, border_width = 1, border_color = color.gray)

if barstate.islast
    // Header
    table.cell(info_table, 0, 0, 'Market', text_color = color.black, bgcolor = color.silver)
    table.cell(info_table, 1, 0, 'EMA 1/2', text_color = color.black, bgcolor = color.silver)
    table.cell(info_table, 2, 0, 'EMA 2/3', text_color = color.black, bgcolor = color.silver)

    // Rows for each market
    for i = 0 to 9 by 1
        market_name = array.get(str.split(array.get(symbols, i), ':'), 1)

        // Get EMAs for the current symbol
        c = array.get(close_prices, i)
        e1 = array.get(ema1_array, i)
        e2 = array.get(ema2_array, i)
        e3 = array.get(ema3_array, i)

        // Determine colors based on MA comparisons
        color1 = na(c) or na(e1) or na(e2) ? color.white : e1 > e2 ? color.green : e1 < e2 ? color.red : color.gray
        color2 = na(c) or na(e2) or na(e3) ? color.white : e2 > e3 ? color.green : e2 < e3 ? color.red : color.gray

        // Populate table cells
        table.cell(info_table, 0, i + 1, market_name, text_color = color.black)
        table.cell(info_table, 1, i + 1, array.get(status1_array, i), text_color = color.black, bgcolor = color1)
        table.cell(info_table, 2, i + 1, array.get(status2_array, i), text_color = color.black, bgcolor = color2)

